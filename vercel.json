{
  "cleanUrls": false,
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/config",
      "destination": "/api/config"
    },
    {
      "source": "/api/media/:action",
      "destination": "/api/media?action=:action"
    },
    {
      "source": "/api/ai/:task",
      "destination": "/api/ai?task=:task"
    }
  ]
}
