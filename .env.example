# =====================================================================
# QEnglish Backend Environment Variables (.env.example)
# HƯỚNG DẪN: Sao chép file này thành ".env" trên máy chủ / local server.
# TUYỆT ĐỐI KHÔNG commit file ".env" thật lên GitHub!
# TUYỆT ĐỐI KHÔNG dán API Key vào code Frontend hay trình duyệt!
# =====================================================================

# Cổng chạy server cục bộ (mặc định: 3000)
PORT=3000

# Lựa chọn 1 (Khuyên dùng): Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Lựa chọn 2 (Hoặc dùng): OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Giới hạn bảo vệ chi phí & chống lạm dụng (Phần 9.3 & 10)
RATE_LIMIT_MAX_PER_MIN=20
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=1400
ALLOWED_ORIGIN=*
