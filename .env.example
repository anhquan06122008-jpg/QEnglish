# ==========================================================================
# QEnglish Backend Environment Configuration Template
# Copy this file to .env on your server or configure in Vercel Environment Variables.
# NEVER commit real .env files or secret API keys into source control or frontend JS!
# ==========================================================================

# Local Server Port (optional, default 3000)
PORT=3000

# Google Gemini API Key (server-side only — never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OR OpenAI API Key (used if GEMINI_API_KEY is omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase Cloud Auth & PostgreSQL Database (public client credentials only)
# Note: Only put SUPABASE_URL and SUPABASE_ANON_KEY here. NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend!
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Set to true in production to require a verified Supabase JWT on /api/ai/* calls
REQUIRE_AUTH_FOR_AI=false

# Security & Rate Limiting
RATE_LIMIT_MAX_PER_MIN=20
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=3600

# Optional CORS restriction in production (e.g. https://your-qenglish-domain.vercel.app)
ALLOWED_ORIGIN=*
